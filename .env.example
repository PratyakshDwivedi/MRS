# Spotify API credentials (OPTIONAL).
# The recommender works fully offline from the bundled clustered dataset.
# Provide these only if you want live Spotify metadata enrichment
# (album art, preview URLs). Obtain them from:
#   https://developer.spotify.com/dashboard  ->  Create an app
#
# Copy this file to `.env` and fill in your values. Never commit `.env`.

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
